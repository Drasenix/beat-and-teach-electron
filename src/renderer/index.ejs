<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="script-src 'self' 'unsafe-inline'"
    />
    <title>Beat and Teach It</title>
    <script>
      try {
        var storedTheme = localStorage.getItem('beat-and-teach:theme');
        if (storedTheme === 'green' || storedTheme === 'pink') {
          document.documentElement.dataset.theme = storedTheme;
        }
      } catch {}
    </script>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
